# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Photos — Vercel Blob (production). Local fallback: .data/images
# Without Supabase, published pages also persist here (private JSON).
BLOB_READ_WRITE_TOKEN=

# Optional pages DB — preferred when set; otherwise Blob, then .data/pages.json
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Auth (magic link). Same project as above. Needed to sign in and tend a page.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Keep — Polar one-time A$5 product. Without these, keep is instant (dev)
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_KEEP=
POLAR_WEBHOOK_SECRET=
# sandbox | production
POLAR_SERVER=sandbox
# Polar Checkout success. {CHECKOUT_ID} is replaced by Polar.
POLAR_SUCCESS_URL=https://www.lost.pink/thanks?checkout_id={CHECKOUT_ID}

# Inbox — Polar AUD products. Server-only. Production fails closed if any ID is missing.
POLAR_PRODUCT_MAILBOX_MONTH=
POLAR_PRODUCT_MAILBOX_SUB=
POLAR_PRODUCT_MAILBOX=
POLAR_PRODUCT_MAILBOX_DAY=
# Webhook events: checkout.updated, order.paid, order.refunded,
# subscription.updated, subscription.canceled, subscription.revoked
MIGADU_USER=
MIGADU_API_KEY=
MIGADU_DOMAIN=lost.pink

# Lifecycle mail as support@lost.pink. Server-only. Never expose to the browser.
MIGADU_SMTP_USER=
MIGADU_SMTP_PASSWORD=
MAILBOX_ALERT_TO=

# Protects /api/cron/expire on Vercel
CRON_SECRET=

# Account SMS (Twilio Verify). Without these, join accepts code 000000 in dev.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Encrypts mailbox IMAP passwords. Falls back to the service role key.
MAILBOX_SECRET_KEY=
