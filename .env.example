# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Photos — Vercel Blob (production). Local fallback: .data/images
# Without Supabase, published pages also persist here (private JSON).
BLOB_READ_WRITE_TOKEN=

# Optional pages DB — preferred when set; otherwise Blob, then .data/pages.json
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Auth (magic link). Same project as above. Needed to come back and tend a shrine.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Keep — Polar one-time A$5 product. Without these, keep is instant (dev)
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_KEEP=
POLAR_WEBHOOK_SECRET=
# sandbox | production
POLAR_SERVER=sandbox

# Protects /api/cron/expire on Vercel
CRON_SECRET=
